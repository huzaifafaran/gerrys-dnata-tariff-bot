# Gerry's / dnata Tariff WhatsApp Bot - Environment Configuration Template
APP_ENV=development
APP_TIMEZONE=Asia/Karachi
DATABASE_URL=sqlite:///./local_dev.db
API_KEY=
TARIFF_PROFILE=DEMO_LEGACY
ENABLE_DEV_CHAT=true

# WhatsApp Bridge (Baileys / WAHA interface compatible)
WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default

# OpenAI API Key for Natural Language Understanding (Entity Extractor)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Session & Webhook Configuration
SESSION_TTL_MINUTES=60
LOG_RETENTION_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000
